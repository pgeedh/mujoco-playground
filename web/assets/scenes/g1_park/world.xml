<mujoco model="g1 delivery task">
  <include file="g1.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.65" ambient="0.35 0.35 0.38" specular="0.5 0.5 0.5"/>
    <rgba haze="0.75 0.82 0.9 1"/>
    <global azimuth="140" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.85" rgb2="0.92 0.96 1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.27 0.46 0.24" rgb2="0.22 0.4 0.2"
      markrgb="0.55 0.65 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="25 25" reflectance="0.03"/>

    <texture type="2d" name="pathtex" builtin="checker" mark="none" rgb1="0.72 0.68 0.6" rgb2="0.66 0.62 0.55" width="64" height="64"/>
    <material name="path" texture="pathtex" texuniform="true" texrepeat="2 2" reflectance="0.02"/>

    <material name="plate" rgba="0.92 0.92 0.88 1" shininess="0.4"/>
    <material name="dishwasher_body" rgba="0.68 0.7 0.72 1" shininess="0.5" reflectance="0.15"/>
    <material name="dishwasher_rack" rgba="0.35 0.36 0.38 1"/>
    <material name="counter" rgba="0.8 0.78 0.74 1"/>

    <material name="trunk" rgba="0.38 0.26 0.15 1"/>
    <material name="foliage" rgba="0.24 0.45 0.2 1"/>
    <material name="foliage2" rgba="0.3 0.52 0.24 1"/>
    <material name="bench" rgba="0.4 0.28 0.16 1"/>
    <material name="lamp_post" rgba="0.2 0.2 0.22 1"/>
    <material name="lamp_glow" rgba="1 0.92 0.7 1" emission="0.8"/>
  </asset>

  <worldbody>
    <light pos="4 0 6" dir="-0.3 0 -1" diffuse="0.5 0.48 0.42" directional="true" castshadow="true"/>

    <!-- contype/conaffinity: bit1 (default) is the robot+world group, bit3
         (value 4) is the "prop" group for grabbable plates. floor/counter
         accept both so plates still rest on them, but plates don't collide
         with the robot's own body — a kinematically-snapped held plate
         colliding with the wrist/arm mesh every step was fighting the
         teleport and visibly destabilizing the walking policy. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="5"/>

    <!-- Stone path from spawn out toward the objects, so the route is
         visually obvious rather than just open grass. -->
    <geom type="box" size="0.5 0.35 0.005" pos="0.3 0 0.006" material="path"/>
    <geom type="box" size="0.5 0.35 0.005" pos="1.3 0 0.006" material="path"/>
    <geom type="box" size="0.5 0.5 0.005" pos="2.3 0 0.006" material="path"/>

    <!-- Task: load 3 plates into the dishwasher (Q = right hand, E = left
         hand — carry two at once if you like). Plates start stacked on a
         small counter right in front of spawn; the dishwasher is a short
         walk further down the path. -->
    <!-- Non-colliding w.r.t. the robot (contype/conaffinity 4 = the prop
         group only) — a solid 0.56m-tall counter directly in the walking
         path would otherwise physically block/trip the walking policy,
         exactly like the barrier obstacle did in an earlier version of
         this scene. It still collides with the plates (also group 4) so
         they visibly rest on top of it. -->
    <body name="counter" pos="1 0 0">
      <geom type="box" size="0.35 0.55 0.28" pos="0 0 0.28" material="counter" contype="4" conaffinity="4"/>
    </body>
    <body name="grab_plate1" pos="1 -0.22 0.575">
      <freejoint/>
      <geom name="grab_plate1_geom" type="cylinder" size="0.09 0.015" material="plate" density="400" contype="4" conaffinity="4"/>
    </body>
    <body name="grab_plate2" pos="1 0 0.575">
      <freejoint/>
      <geom name="grab_plate2_geom" type="cylinder" size="0.09 0.015" material="plate" density="400" contype="4" conaffinity="4"/>
    </body>
    <body name="grab_plate3" pos="1 0.22 0.575">
      <freejoint/>
      <geom name="grab_plate3_geom" type="cylinder" size="0.09 0.015" material="plate" density="400" contype="4" conaffinity="4"/>
    </body>

    <!-- Dishwasher: an open-front appliance shell (non-colliding — a
         decorative target, not a physical obstacle the untrained walking
         policy could trip on) with a visible rack tray inside. The JS
         delivery check just measures (x,y) distance from this body's
         origin against each plate. -->
    <body name="dishwasher" pos="3 0 0">
      <geom type="box" size="0.03 0.55 0.4" pos="0.47 0 0.43" material="dishwasher_body" contype="0" conaffinity="0"/>
      <geom type="box" size="0.5 0.03 0.4" pos="0 0.52 0.43" material="dishwasher_body" contype="0" conaffinity="0"/>
      <geom type="box" size="0.5 0.03 0.4" pos="0 -0.52 0.43" material="dishwasher_body" contype="0" conaffinity="0"/>
      <geom type="box" size="0.5 0.55 0.03" pos="0 0 0.03" material="dishwasher_body" contype="0" conaffinity="0"/>
      <geom type="box" size="0.5 0.55 0.03" pos="0 0 0.86" material="dishwasher_body" contype="0" conaffinity="0"/>
      <geom type="box" size="0.44 0.5 0.008" pos="0 0 0.2" material="dishwasher_rack" contype="0" conaffinity="0"/>
    </body>

    <!-- A bench near spawn, just for atmosphere. -->
    <body name="bench" pos="-0.9 1.1 0">
      <geom type="box" size="0.5 0.18 0.03" pos="0 0 0.4" material="bench"/>
      <geom type="box" size="0.04 0.04 0.2" pos="0.4 0.12 0.2" material="bench"/>
      <geom type="box" size="0.04 0.04 0.2" pos="-0.4 0.12 0.2" material="bench"/>
      <geom type="box" size="0.04 0.04 0.2" pos="0.4 -0.12 0.2" material="bench"/>
      <geom type="box" size="0.04 0.04 0.2" pos="-0.4 -0.12 0.2" material="bench"/>
    </body>

    <!-- A couple of lamp posts for atmosphere near the path. -->
    <body name="lamp1" pos="0.3 -1.3 0">
      <geom type="cylinder" size="0.03 0.9" pos="0 0 0.9" material="lamp_post" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.08" pos="0 0 1.85" material="lamp_glow" contype="0" conaffinity="0"/>
      <light pos="0 0 1.9" diffuse="0.6 0.55 0.4" specular="0.2 0.2 0.15" directional="false" castshadow="false" attenuation="1 0 1"/>
    </body>
    <body name="lamp2" pos="2.3 1.3 0">
      <geom type="cylinder" size="0.03 0.9" pos="0 0 0.9" material="lamp_post" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.08" pos="0 0 1.85" material="lamp_glow" contype="0" conaffinity="0"/>
      <light pos="0 0 1.9" diffuse="0.6 0.55 0.4" specular="0.2 0.2 0.15" directional="false" castshadow="false" attenuation="1 0 1"/>
    </body>

    <!-- Decorative trees scattered around the perimeter, well clear of the
         walking path — non-colliding so a stray walk near one can't trip
         the walking policy (it was never trained around obstacles). -->
    <body name="tree1" pos="-2.5 3 0">
      <geom type="cylinder" size="0.15 0.9" pos="0 0 0.9" material="trunk" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.75" pos="0 0 2.0" material="foliage" contype="0" conaffinity="0"/>
    </body>
    <body name="tree2" pos="-2 -3.2 0">
      <geom type="cylinder" size="0.18 1.1" pos="0 0 1.1" material="trunk" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.9" pos="0 0 2.4" material="foliage2" contype="0" conaffinity="0"/>
    </body>
    <body name="tree3" pos="5.5 3.5 0">
      <geom type="cylinder" size="0.16 1.0" pos="0 0 1.0" material="trunk" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.8" pos="0 0 2.2" material="foliage" contype="0" conaffinity="0"/>
    </body>
    <body name="tree4" pos="5.8 -2.8 0">
      <geom type="cylinder" size="0.17 0.95" pos="0 0 0.95" material="trunk" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.85" pos="0 0 2.15" material="foliage2" contype="0" conaffinity="0"/>
    </body>
    <body name="tree5" pos="1.5 -4 0">
      <geom type="cylinder" size="0.15 0.85" pos="0 0 0.85" material="trunk" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.7" pos="0 0 1.9" material="foliage" contype="0" conaffinity="0"/>
    </body>
    <body name="tree6" pos="1.2 4.2 0">
      <geom type="cylinder" size="0.18 1.05" pos="0 0 1.05" material="trunk" contype="0" conaffinity="0"/>
      <geom type="sphere" size="0.88" pos="0 0 2.3" material="foliage2" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
